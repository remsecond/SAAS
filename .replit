run = "npm start"
modules = ["nodejs-20", "web"]

[deployment]
# Configure maximum servers = 1 in Publishing settings before release.
# Sessions and attempt limits are in-memory; restarts sign everyone out.
run = ["sh", "-c", "npm start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 node --env-file=private-data/access-hLfCFq/runtime.env server.cjs"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
